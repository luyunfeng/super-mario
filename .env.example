# Copy to .env. Never commit real credentials.
SUPER_MARIO_FEISHU_ENABLED=0
SUPER_MARIO_FEISHU_APP_ID=
SUPER_MARIO_FEISHU_APP_SECRET=
# Optional: separately authorized read-only user-message profile.
SUPER_MARIO_FEISHU_USER_PROFILE=
# Set a token before connecting execution nodes or listening externally.
SUPER_MARIO_TOKEN=
# SUPER_MARIO_PROVIDER=anthropic
# SUPER_MARIO_MODEL=your-model-id
# ANTHROPIC_API_KEY=
